# ---------------------------------

def measure_length_simple(points_3d):
    """
    Simple fallback length measurement using PCA (Principal Component Analysis)
    to find the main axis of the point cloud.
    """
    if len(points_3d) < 10:
        return 0.0, np.array([])

    # Center the points
    centroid = np.mean(points_3d, axis=0)
    centered_points = points_3d - centroid

    # Compute PCA
    cov_matrix = np.cov(centered_points.T)
    eigenvalues, eigenvectors = np.linalg.eig(cov_matrix)

    # Find principal axis (eigenvector with largest eigenvalue)
    main_axis_idx = np.argmax(eigenvalues)
    main_axis = eigenvectors[:, main_axis_idx]

    # Project points onto main axis
    projections = np.dot(centered_points, main_axis)

    # Find extent along main axis
    min_proj = np.min(projections)
    max_proj = np.max(projections)

    # Length is the extent along main axis
    length = max_proj - min_proj
    length_cm = length * 100.0 * LENGTH_CALIBRATION_FACTOR  # Convert to cm WITH CALIBRATION

    # Create simple centerline (just endpoints along main axis)
    start_point = centroid + min_proj * main_axis
    end_point = centroid + max_proj * main_axis
    centerline = np.array([start_point, end_point])

    return length_cm, centerline

