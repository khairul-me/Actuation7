def measure_asparagus_length(points_3d):
    """
    Measure the length of asparagus from 3D point cloud using skeletonization.
    With extensive debugging and fallback options.
    """
    global length_debug_info

    if not LENGTH_MEASUREMENT_AVAILABLE:
        # Use simple fallback method
        return measure_length_simple(points_3d)

    if len(points_3d) < MIN_POINTS_FOR_LENGTH:
        length_debug_info = f"Too few points: {len(points_3d)} < {MIN_POINTS_FOR_LENGTH}"
        return 0.0, np.array([])

    try:
        if DEBUG_LENGTH_MEASUREMENT:
            print(f"\n📏 Starting length measurement with {len(points_3d)} points")

        # Step 1: Clean point cloud using DBSCAN clustering
        pcd = o3d.geometry.PointCloud()
        pcd.points = o3d.utility.Vector3dVector(points_3d)

        # Perform DBSCAN clustering
        labels = np.array(pcd.cluster_dbscan(eps=DBSCAN_EPS, min_points=DBSCAN_MIN_POINTS))

        if DEBUG_LENGTH_MEASUREMENT:
            print(f"   DBSCAN found {len(np.unique(labels[labels >= 0]))} clusters")

        if len(labels) == 0 or np.all(labels == -1):
            length_debug_info = "DBSCAN: No clusters found"
            # Fallback to simple method
            return measure_length_simple(points_3d)

        # Keep only the largest cluster
        unique_labels = labels[labels >= 0]
        if len(unique_labels) == 0:
            length_debug_info = "DBSCAN: Only noise points"
            return measure_length_simple(points_3d)

        largest_cluster = np.argmax(np.bincount(unique_labels))
        cluster_mask = labels == largest_cluster
        cleaned_points = points_3d[cluster_mask]

        if DEBUG_LENGTH_MEASUREMENT:
            print(f"   Largest cluster has {len(cleaned_points)} points")

        if len(cleaned_points) < MIN_POINTS_FOR_LENGTH:
            length_debug_info = f"Cluster too small: {len(cleaned_points)} points"
            return measure_length_simple(cleaned_points)

        # Step 2: Voxelize the point cloud
        pts = cleaned_points
        mn = pts.min(axis=0)
        mx = pts.max(axis=0)

        # Calculate grid dimensions
        grid_size = np.ceil((mx - mn) / VOXEL_SIZE).astype(int) + 1  # Add 1 for safety

        if DEBUG_LENGTH_MEASUREMENT:
            print(f"   Voxel grid size: {grid_size}")
            print(f"   Bounding box: {mx - mn} meters")

        # Safety check for grid size
        if np.any(grid_size > 300) or np.any(grid_size <= 0):
            length_debug_info = f"Invalid grid size: {grid_size}"
            return measure_length_simple(cleaned_points)

        # Create voxel grid
        grid_idx = np.floor((pts - mn) / VOXEL_SIZE).astype(int)

        # Ensure indices are within bounds
        for i in range(3):
            grid_idx[:, i] = np.clip(grid_idx[:, i], 0, grid_size[i] - 1)

        # Create binary volume
        vol = np.zeros(tuple(grid_size), dtype=np.uint8)
        vol[grid_idx[:, 0], grid_idx[:, 1], grid_idx[:, 2]] = 1

        filled_voxels = np.sum(vol)
        if DEBUG_LENGTH_MEASUREMENT:
            print(f"   Filled voxels: {filled_voxels}")

        if filled_voxels < 5:
            length_debug_info = f"Too few voxels: {filled_voxels}"
            return measure_length_simple(cleaned_points)

        # Step 3: Apply 3D skeletonization
        skeleton = skeletonize_3d(vol).astype(bool)

        # Get skeleton points
        sk_coords = np.argwhere(skeleton)

        if DEBUG_LENGTH_MEASUREMENT:
            print(f"   Skeleton points: {len(sk_coords)}")

        if len(sk_coords) < 2:
            length_debug_info = "Skeletonization failed"
            return measure_length_simple(cleaned_points)

        # Convert back to world coordinates
        sk_pts = sk_coords * VOXEL_SIZE + mn

        # Step 4: Build graph from skeleton
        if len(sk_pts) == 2:
            # Simple case: just two points
            length = np.linalg.norm(sk_pts[1] - sk_pts[0])
            return length * 100.0, sk_pts

        tree = cKDTree(sk_pts)
        radius = SKELETON_NEIGHBOR_RADIUS_FACTOR * VOXEL_SIZE
        neighbors = tree.query_ball_point(sk_pts, r=radius)

        # Create graph
        G = nx.Graph()
        for i, nbrs in enumerate(neighbors):
            for j in nbrs:
                if i != j:
                    dist = np.linalg.norm(sk_pts[i] - sk_pts[j])
                    G.add_edge(i, j, weight=dist)

        if DEBUG_LENGTH_MEASUREMENT:
            print(f"   Graph nodes: {len(G.nodes())}, edges: {len(G.edges())}")

        if len(G.nodes()) < 2:
            length_debug_info = "Graph construction failed"
            return measure_length_simple(cleaned_points)

        # Ensure graph is connected
        if not nx.is_connected(G):
            # Get largest connected component
            largest_cc = max(nx.connected_components(G), key=len)
            G = G.subgraph(largest_cc).copy()
            if DEBUG_LENGTH_MEASUREMENT:
                print(f"   Using largest connected component: {len(G.nodes())} nodes")

        # Step 5: Find main path (longest shortest path)
        # Find endpoints (degree 1 nodes)
        degrees = dict(G.degree())
        endpoints = [node for node, deg in degrees.items() if deg == 1]

        if DEBUG_LENGTH_MEASUREMENT:
            print(f"   Found {len(endpoints)} endpoints")

        if len(endpoints) < 2:
            # If no clear endpoints, use farthest points
            if len(G.nodes()) > 0:
                # Pick arbitrary starting point
                nodes_list = list(G.nodes())
                start_node = nodes_list[0]
                try:
                    lengths = nx.single_source_dijkstra_path_length(G, start_node)
                    if lengths:
                        endpoints = [start_node, max(lengths, key=lengths.get)]
                    else:
                        length_debug_info = "No path lengths found"
                        return measure_length_simple(cleaned_points)
                except:
                    length_debug_info = "Path finding failed"
                    return measure_length_simple(cleaned_points)
            else:
                length_debug_info = "No graph nodes"
                return measure_length_simple(cleaned_points)

        # Find longest path between endpoints
        best_path = None
        max_length = 0

        for i, endpoint_a in enumerate(endpoints[:min(10, len(endpoints))]):  # Limit search
            try:
                distances = nx.single_source_dijkstra_path_length(G, endpoint_a)
                if distances:
                    farthest = max(distances, key=distances.get)
                    if distances[farthest] > max_length:
                        max_length = distances[farthest]
                        best_path = nx.shortest_path(G, endpoint_a, farthest, weight='weight')
            except:
                continue

        if best_path is None or len(best_path) < 2:
            length_debug_info = "No valid path found"
            return measure_length_simple(cleaned_points)

        # Get centerline points
        centerline = sk_pts[best_path]

        if DEBUG_LENGTH_MEASUREMENT:
            print(f"   Path length: {len(best_path)} nodes")

        # Step 6: Calculate length
        if len(centerline) < 4:  # Need at least 4 points for cubic spline
            # Fall back to simple distance sum
            length = np.sum(np.linalg.norm(np.diff(centerline, axis=0), axis=1))
            length_debug_info = f"Simple sum: {len(centerline)} points"
            return length * 100.0, centerline

        try:
            # Fit parametric spline
            tck, u = splprep([centerline[:, 0], centerline[:, 1], centerline[:, 2]],
                           s=SPLINE_SMOOTHING, k=min(3, len(centerline)-1))

            # Sample spline at many points
            uu = np.linspace(0, 1, SPLINE_SAMPLES)

            # Calculate derivatives (velocity)
            dx, dy, dz = splev(uu, tck, der=1)

            # Calculate speed at each point
            speed = np.sqrt(dx**2 + dy**2 + dz**2)

            # Integrate to get arc length
            length = simps(speed, uu)
            length_cm = 100.0 * length * LENGTH_CALIBRATION_FACTOR  # Convert to cm with calibration

            length_debug_info = f"Success: {length_cm:.1f}cm"
            if DEBUG_LENGTH_MEASUREMENT:
                print(f"   ✅ Measured length: {length_cm:.1f} cm")

            return length_cm, centerline

        except Exception as e:
            # If spline fitting fails, use simple sum
            length = np.sum(np.linalg.norm(np.diff(centerline, axis=0), axis=1))
            length_debug_info = f"Spline failed, using sum"
            return length * 100.0 * LENGTH_CALIBRATION_FACTOR, centerline

    except Exception as e:
        length_debug_info = f"Error: {str(e)[:30]}"
        if DEBUG_LENGTH_MEASUREMENT:
            print(f"❌ Length measurement error: {e}")
        return measure_length_simple(points_3d)

